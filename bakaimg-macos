    [ "$1" -ge 1 ] && [ "$1" -le 365 ] || fail "保留天数必须在1到365之间。"
    [ "$2" -ge 1 ] && [ "$2" -le 1024 ] || fail "单文件大小必须在1到1024MiB之间。"
    project_root=$(config_get PROJECT_ROOT); run_user=$(config_get RUN_USER); domain=$(config_get DOMAIN)
    port=$(config_get LOCAL_PORT); brew_path=$(config_get BREW)
