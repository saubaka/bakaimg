recovery_link() {
    [ "$MODE" = local ] || fail "本机恢复链接只在本机运行方式下提供；正式部署请使用 flask local-recovery-link。"
    local_require_project
    local_ensure_env || fail "需要先安装运行环境。"
    FLASK_PORT=$(local_active_port)
    output=$(local_flask local-recovery-link) || fail "无法生成恢复链接。"
    link=$(printf '%s\n' "$output" | /usr/bin/sed -n 's/^RECOVERY_URL=//p' | /usr/bin/head -n 1)
    [ -n "$link" ] || fail "无法生成恢复链接。"
    link=$(printf '%s' "$link" | /usr/bin/sed "s#^http://127.0.0.1:[0-9]*/#http://127.0.0.1:$FLASK_PORT/#")
    say "本机管理员恢复链接（5分钟内有效，只能使用一次）："
