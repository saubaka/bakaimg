#!/bin/sh
# baka图床 macOS 管理面板
#
# 两种运行方式，自动识别：
#   本机运行  在项目目录直接运行，不需要sudo、域名或证书，适合自己的Mac。
#   正式部署  执行过 deploy-macos.sh 之后，由launchd托管应用与Nginx，需要管理员权限。
set -eu

VERSION="0.16.0"
LABEL="com.saubaka.bakaimg"
NGINX_LABEL="com.saubaka.bakaimg.nginx"
MAINTENANCE_LABEL="com.saubaka.bakaimg.maintenance"
CONFIG_DIR="${BAKAIMG_MACOS_CONFIG_DIR:-/Library/Application Support/bakaimg}"
CONFIG_FILE="$CONFIG_DIR/manager.conf"
ENV_FILE="$CONFIG_DIR/bakaimg.env"
TLS_DIR="$CONFIG_DIR/tls"
CERT_FILE="$TLS_DIR/origin.pem"
KEY_FILE="$TLS_DIR/origin.key"
NGINX_FILE="$CONFIG_DIR/nginx.conf"
APP_PLIST="$CONFIG_DIR/$LABEL.plist"
NGINX_PLIST="$CONFIG_DIR/$NGINX_LABEL.plist"
MAINTENANCE_PLIST="$CONFIG_DIR/$MAINTENANCE_LABEL.plist"
AUTOSTART_OFF_MARK="$CONFIG_DIR/autostart-off"
LAUNCH_DIR="${BAKAIMG_MACOS_LAUNCH_DIR:-/Library/LaunchDaemons}"
LOG_DIR="${BAKAIMG_MACOS_LOG_DIR:-/Library/Logs/bakaimg}"
INSTALL_DIR_DEFAULT="/opt/bakaimg/current"
PORT_DEFAULT=5200
LAUNCHCTL="${BAKAIMG_LAUNCHCTL:-/bin/launchctl}"
LSOF="${BAKAIMG_LSOF:-/usr/sbin/lsof}"
LOG_RETENTION_DEFAULT=14
LOG_MAX_MIB_DEFAULT=32

# ---------------------------------------------------------------- 界面

setup_colors() {
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_DIM=""; C_BOLD=""; C_RESET=""
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
        C_RED=$(printf '\033[31m'); C_GREEN=$(printf '\033[32m'); C_YELLOW=$(printf '\033[33m')
        C_DIM=$(printf '\033[2m'); C_BOLD=$(printf '\033[1m'); C_RESET=$(printf '\033[0m')
    fi
}

say() { printf '%s\n' "$*"; }
fail() { printf '错误：%s\n' "$*" >&2; exit 1; }

badge_on() { printf '%s●%s %s' "$C_GREEN" "$C_RESET" "$1"; }
badge_off() { printf '%s●%s %s' "$C_RED" "$C_RESET" "$1"; }
badge_warn() { printf '%s●%s %s' "$C_YELLOW" "$C_RESET" "$1"; }
dim() { printf '%s%s%s' "$C_DIM" "$1" "$C_RESET"; }
row() { printf '  %s  %s\n' "$1" "$2"; }

confirm() {
    prompt=$1
    default=${2:-n}
    if [ ! -t 0 ]; then [ "$default" = y ]; return; fi
    hint='[y/N]'
    [ "$default" != y ] || hint='[Y/n]'
    printf '%s %s ' "$prompt" "$hint"
    IFS= read -r answer || answer=""
    case ${answer:-$default} in y|Y|yes|YES|是) return 0 ;; *) return 1 ;; esac
}

pause_panel() {
    [ -t 0 ] || return 0
    printf '\n按回车返回面板…'
    IFS= read -r _ignored || true
}

quiet_run() {
    description=$1
    shift
    temp_log=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/bakaimg.XXXXXX")
    printf '%s…' "$description"
    if "$@" >"$temp_log" 2>&1; then
        printf ' 完成\n'
        /bin/rm -f "$temp_log"
        return 0
    fi
    printf ' 失败\n'
    /usr/bin/tail -n 25 "$temp_log"
    /bin/rm -f "$temp_log"
    return 1
}

short_path() {
    case $1 in
        "${HOME:-/nonexistent}"/*) printf '~%s' "${1#"$HOME"}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# ---------------------------------------------------------------- 基础工具

resolve_self() {
    target=$1
    while [ -L "$target" ]; do
        link=$(/usr/bin/readlink "$target")
        case $link in
            /*) target=$link ;;
            *) target="$(/usr/bin/dirname "$target")/$link" ;;
        esac
    done
    directory=$(cd "$(/usr/bin/dirname "$target")" && pwd -P)
    printf '%s/%s' "$directory" "$(/usr/bin/basename "$target")"
}

require_macos() {
    [ "$(uname -s)" = "Darwin" ] || fail "此管理脚本只适用于macOS。"
    case "$(uname -m)" in arm64|x86_64) ;; *) fail "仅支持Apple芯片或Intel Mac。" ;; esac
}

require_root() {
    [ "$(id -u)" -eq 0 ] || fail "请使用 sudo bakaimg $* 运行。"
}

config_get() {
    key=$1
    [ -f "$CONFIG_FILE" ] || return 0
    /usr/bin/awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$CONFIG_FILE"
}

valid_domain() {
    length=$(printf '%s' "$1" | /usr/bin/wc -c | /usr/bin/tr -d ' ')
    [ "$length" -ge 4 ] && [ "$length" -le 253 ] || return 1
    printf '%s' "$1" | /usr/bin/grep -Eiq '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
}

normalize_domain() {
    value=$(printf '%s' "$1" | /usr/bin/tr '[:upper:]' '[:lower:]' | /usr/bin/sed 's/[[:space:]]//g; s/\.$//')
    valid_domain "$value" || fail "域名必须是单个完整主机名，不能包含协议、端口、路径或通配符。"
    printf '%s' "$value"
}

valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1024 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

find_brew() {
    if [ -x /opt/homebrew/bin/brew ]; then printf '%s' /opt/homebrew/bin/brew
    elif [ -x /usr/local/bin/brew ]; then printf '%s' /usr/local/bin/brew
    elif command -v brew >/dev/null 2>&1; then command -v brew
    else return 1
    fi
}

detect_run_user() {
    requested=${BAKAIMG_RUN_USER:-${SUDO_USER:-}}
    if [ -n "$requested" ] && [ "$requested" != "root" ]; then printf '%s' "$requested"; return; fi
    owner=$(config_get RUN_USER || true)
    if [ -n "$owner" ]; then printf '%s' "$owner"; return; fi
    owner=$(/usr/bin/stat -f '%Su' "${BAKAIMG_PROJECT_ROOT:-$INSTALL_DIR_DEFAULT}" 2>/dev/null || true)
    [ -n "$owner" ] && [ "$owner" != "root" ] || fail "无法确定运行用户，请以普通管理员账号执行 sudo。"
    printf '%s' "$owner"
}

run_as_user() {
    target_user=$1
    shift
    /usr/bin/sudo -H -u "$target_user" "$@"
}

brew_value() {
    brew_path=$1
    shift
    if [ "$(id -u)" -eq 0 ]; then
        brew_user=$(config_get RUN_USER || true)
        if [ -n "$brew_user" ] && [ "$brew_user" != root ]; then
            run_as_user "$brew_user" "$brew_path" "$@"
            return
        fi
    fi
    "$brew_path" "$@"
}

atomic_install() {
    source_file=$1
    destination=$2
    mode=$3
    parent=$(/usr/bin/dirname "$destination")
    /bin/mkdir -p "$parent"
    temp_file="$destination.tmp.$$"
    /bin/cp "$source_file" "$temp_file"
    /bin/chmod "$mode" "$temp_file"
    /bin/mv -f "$temp_file" "$destination"
}

write_config() {
    project_root=$1
    run_user=$2
    domain=$3
    local_port=$4
    retention_days=$5
    max_size_mib=$6
    brew_path=$7
    /bin/mkdir -p "$CONFIG_DIR"
    temp_file="$CONFIG_FILE.tmp.$$"
    {
        printf 'PROJECT_ROOT=%s\n' "$project_root"
        printf 'RUN_USER=%s\n' "$run_user"
        printf 'DOMAIN=%s\n' "$domain"
        printf 'LOCAL_PORT=%s\n' "$local_port"
        printf 'RETENTION_DAYS=%s\n' "$retention_days"
        printf 'MAX_SIZE_MIB=%s\n' "$max_size_mib"
        printf 'BREW=%s\n' "$brew_path"
    } > "$temp_file"
    /bin/chmod 600 "$temp_file"
    /bin/mv -f "$temp_file" "$CONFIG_FILE"
}

# ---------------------------------------------------------------- 端口与进程

port_python() {
    python_bin=${BAKAIMG_PORT_PYTHON:-}
    if [ -z "$python_bin" ] && [ "$MODE" = local ] && [ -x "$LOCAL_VENV/bin/python" ]; then
        python_bin="$LOCAL_VENV/bin/python"
    fi
    if [ -z "$python_bin" ] && [ "$MODE" = production ]; then
        python_bin=$(config_get PYTHON 2>/dev/null || true)
        if [ -z "$python_bin" ]; then
            brew_path=$(find_brew 2>/dev/null || true)
            if [ -n "$brew_path" ]; then
                python_bin="$(brew_value "$brew_path" --prefix python@3.14 2>/dev/null)/bin/python3.14"
            fi
        fi
    fi
    if [ ! -x "$python_bin" ]; then
        # /usr/bin/python3 只是开发者工具的入口，未安装时调用会弹出安装窗口。
        python_bin=""
        if /usr/bin/xcode-select -p >/dev/null 2>&1 && [ -x /usr/bin/python3 ]; then python_bin=/usr/bin/python3; fi
    fi
    printf '%s' "$python_bin"
}

listen_pid() {
    "$LSOF" -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null | /usr/bin/head -n 1 || true
}

port_is_free() {
    port=$1
    [ -z "$(listen_pid "$port")" ] || return 1
    probe_python=$(port_python)
    [ -n "$probe_python" ] || return 0
    "$probe_python" - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    sock.bind(("127.0.0.1", port))
except OSError:
    raise SystemExit(1)
finally:
    sock.close()
PY
}

find_available_port() {
    candidate=$1
    valid_port "$candidate" || candidate=$PORT_DEFAULT
    first=$candidate
    while ! port_is_free "$candidate"; do
        candidate=$((candidate + 1))
        [ "$candidate" -le 65535 ] || candidate=1024
        [ "$candidate" -ne "$first" ] || fail "没有可用的本地端口。"
    done
    printf '%s' "$candidate"
}

job_loaded() { "$LAUNCHCTL" print "$1" >/dev/null 2>&1; }

job_pid() {
    "$LAUNCHCTL" print "$1" 2>/dev/null | /usr/bin/awk '$1 == "pid" && $2 == "=" {print $3; exit}'
}

label_disabled() {
    "$LAUNCHCTL" print-disabled "$1" 2>/dev/null | /usr/bin/grep -F "\"$2\"" | /usr/bin/grep -Eq '=> (true|disabled)'
}

pid_alive() { [ -n "${1:-}" ] && /bin/kill -0 "$1" 2>/dev/null; }

pid_is_app() {
    process_command=$(/bin/ps -o command= -p "$1" 2>/dev/null || true)
    case $process_command in *wsgi:app*|*run-local*|*serve.py*) return 0 ;; esac
    return 1
}

elapsed_of() {
    value=$(/bin/ps -o etime= -p "$1" 2>/dev/null | /usr/bin/tr -d ' ' || true)
    case $value in
        *-*) printf '%s天 %s' "${value%%-*}" "${value#*-}" ;;
        *) printf '%s' "$value" ;;
    esac
}

health_body() {
    port=$1
    if [ "$MODE" = production ]; then
        domain=$(config_get DOMAIN || true)
        /usr/bin/curl -fsS -m 2 -H "Host: $domain" -H "X-Forwarded-Proto: https" "http://127.0.0.1:$port/healthz" 2>/dev/null | /usr/bin/tr -d '\n' || true
    else
        /usr/bin/curl -fsS -m 2 "http://127.0.0.1:$port/healthz" 2>/dev/null | /usr/bin/tr -d '\n' || true
    fi
}

health_version() {
    printf '%s' "$1" | /usr/bin/sed -n 's/.*"version": *"\([^"]*\)".*/\1/p'
}

json_bool() { if [ "$1" = 1 ]; then printf true; else printf false; fi; }
json_number() { if [ -n "${1:-}" ]; then printf '%s' "$1"; else printf null; fi; }

# ---------------------------------------------------------------- 渲染

xml_escape() {
    printf '%s' "$1" | /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

render_environment() {
    output=$1
    domain=$2
    port=$3
    secret=$4
    {
        printf 'CLOUDNEST_ENV=production\n'
        printf 'CLOUDNEST_SITE_URL=https://%s\n' "$domain"
        printf 'CLOUDNEST_ALLOWED_HOST=%s\n' "$domain"
        printf 'CLOUDNEST_HOST=127.0.0.1\n'
        printf 'CLOUDNEST_PORT=%s\n' "$port"
        printf 'CLOUDNEST_TRUST_PROXY_HOPS=1\n'
        printf 'CLOUDNEST_THREADS=8\n'
        printf 'CLOUDNEST_SECRET_KEY=%s\n' "$secret"
        printf 'PYTHONUNBUFFERED=1\n'
    } > "$output"
    /bin/chmod 600 "$output"
}

render_nginx() {
    output=$1
    domain=$2
    port=$3
    brew_path=$4
    nginx_prefix=$(brew_value "$brew_path" --prefix nginx)
    mime_types="$nginx_prefix/etc/nginx/mime.types"
    [ -f "$mime_types" ] || mime_types="$(brew_value "$brew_path" --prefix)/etc/nginx/mime.types"
    cat > "$output" <<EOF
worker_processes auto;
pid "$CONFIG_DIR/nginx.pid";
error_log "$LOG_DIR/nginx-error.log" warn;

events { worker_connections 1024; }

http {
    include "$mime_types";
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
        ssl_certificate "$CERT_FILE";
        ssl_certificate_key "$KEY_FILE";
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name $domain;
        ssl_certificate "$CERT_FILE";
        ssl_certificate_key "$KEY_FILE";
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:BakaImgTLS:10m;
        ssl_session_timeout 1d;
        client_max_body_size 64m;
        access_log "$LOG_DIR/access.log";
        error_log "$LOG_DIR/nginx-error.log" warn;

        location / {
            proxy_pass http://127.0.0.1:$port;
            proxy_http_version 1.1;
            proxy_set_header Host $domain;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $domain;
            proxy_set_header X-Forwarded-For \$remote_addr;
            proxy_set_header X-Request-ID \$request_id;
            proxy_connect_timeout 10s;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
            proxy_request_buffering off;
        }
    }
}
EOF
}

render_app_plist() {
    output=$1
    manager_path=$2
    project_root=$3
    cat > "$output" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$LABEL</string>
<key>ProgramArguments</key><array><string>$(xml_escape "$manager_path")</string><string>run-service</string></array>
<key>WorkingDirectory</key><string>$(xml_escape "$project_root")</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>3</integer>
<key>ProcessType</key><string>Background</string>
<key>StandardOutPath</key><string>$(xml_escape "$LOG_DIR/app.log")</string>
<key>StandardErrorPath</key><string>$(xml_escape "$LOG_DIR/error.log")</string>
</dict></plist>
EOF
}

render_nginx_plist() {
    output=$1
    nginx_bin=$2
    cat > "$output" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$NGINX_LABEL</string>
<key>ProgramArguments</key><array><string>$(xml_escape "$nginx_bin")</string><string>-c</string><string>$(xml_escape "$NGINX_FILE")</string><string>-g</string><string>daemon off;</string></array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>3</integer>
<key>StandardOutPath</key><string>$(xml_escape "$LOG_DIR/nginx-launch.log")</string>
<key>StandardErrorPath</key><string>$(xml_escape "$LOG_DIR/nginx-error.log")</string>
</dict></plist>
EOF
}

render_maintenance_plist() {
    output=$1
    manager_path=$2
    cat > "$output" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$MAINTENANCE_LABEL</string>
<key>ProgramArguments</key><array><string>$(xml_escape "$manager_path")</string><string>maintenance</string></array>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>20</integer></dict>
<key>LowPriorityIO</key><true/>
<key>StandardOutPath</key><string>$(xml_escape "$LOG_DIR/maintenance.log")</string>
<key>StandardErrorPath</key><string>$(xml_escape "$LOG_DIR/maintenance-error.log")</string>
</dict></plist>
EOF
}

# 本机模式的开机自启任务：登录后由launchd拉起，异常退出自动重启。
render_local_plist() {
    output=$1
    label=${2:-$LOCAL_LABEL}
    run_command=${3:-run-local}
    keep_alive=${4:-1}
    brew_dir=""
    brew_path=$(find_brew 2>/dev/null || true)
    [ -z "$brew_path" ] || brew_dir="$(/usr/bin/dirname "$brew_path"):"
    {
        cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$(xml_escape "$label")</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>$(xml_escape "$SELF")</string><string>$run_command</string></array>
<key>WorkingDirectory</key><string>$(xml_escape "$LOCAL_ROOT")</string>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>$(xml_escape "$brew_dir")/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>RunAtLoad</key><true/>
EOF
        if [ "$keep_alive" = 1 ]; then
            printf '<key>KeepAlive</key><true/>\n<key>ThrottleInterval</key><integer>5</integer>\n'
        fi
        cat <<EOF
<key>StandardOutPath</key><string>$(xml_escape "$LOCAL_APP_LOG")</string>
<key>StandardErrorPath</key><string>$(xml_escape "$LOCAL_APP_LOG")</string>
</dict></plist>
EOF
    } > "$output"
}

# ================================================================ 正式部署（launchd + Nginx）

read_secret() {
    [ -f "$ENV_FILE" ] || return 0
    /usr/bin/awk -F= '$1 == "CLOUDNEST_SECRET_KEY" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE"
}

write_runtime_files() {
    project_root=$(config_get PROJECT_ROOT)
    run_user=$(config_get RUN_USER)
    domain=$(config_get DOMAIN)
    port=$(config_get LOCAL_PORT)
    brew_path=$(config_get BREW)
    [ -n "$project_root" ] && [ -n "$run_user" ] && [ -n "$domain" ] && [ -n "$brew_path" ] || fail "部署配置不完整。"
    secret=$(read_secret || true)
    if [ -z "$secret" ]; then
        openssl_bin="$(brew_value "$brew_path" --prefix openssl@3)/bin/openssl"
        [ -x "$openssl_bin" ] || fail "未找到OpenSSL 3，无法生成运行密钥。"
        secret=$("$openssl_bin" rand -hex 48)
    fi
    render_environment "$ENV_FILE.tmp.$$" "$domain" "$port" "$secret"
    /bin/mv -f "$ENV_FILE.tmp.$$" "$ENV_FILE"
    render_nginx "$NGINX_FILE.tmp.$$" "$domain" "$port" "$brew_path"
    /bin/mv -f "$NGINX_FILE.tmp.$$" "$NGINX_FILE"
    manager_path=/usr/local/bin/bakaimg
    render_app_plist "$APP_PLIST.tmp.$$" "$manager_path" "$project_root"
    /bin/mv -f "$APP_PLIST.tmp.$$" "$APP_PLIST"
    nginx_bin="$(brew_value "$brew_path" --prefix nginx)/bin/nginx"
    [ -x "$nginx_bin" ] || nginx_bin="$(brew_value "$brew_path" --prefix)/bin/nginx"
    render_nginx_plist "$NGINX_PLIST.tmp.$$" "$nginx_bin"
    /bin/mv -f "$NGINX_PLIST.tmp.$$" "$NGINX_PLIST"
    render_maintenance_plist "$MAINTENANCE_PLIST.tmp.$$" "$manager_path"
    /bin/mv -f "$MAINTENANCE_PLIST.tmp.$$" "$MAINTENANCE_PLIST"
    /bin/chmod 600 "$ENV_FILE" "$CONFIG_FILE" "$KEY_FILE" 2>/dev/null || true
    /bin/chmod 644 "$NGINX_FILE" "$APP_PLIST" "$NGINX_PLIST" "$MAINTENANCE_PLIST"
    /usr/sbin/chown -R root:wheel "$CONFIG_DIR"
    /usr/sbin/chown -R "$run_user":staff "$project_root/instance" "$LOG_DIR"
}

# 把launchd配置复制到系统启动目录，等同于“开机自启已开启”。
copy_plists() {
    atomic_install "$APP_PLIST" "$LAUNCH_DIR/$LABEL.plist" 644
    atomic_install "$NGINX_PLIST" "$LAUNCH_DIR/$NGINX_LABEL.plist" 644
    atomic_install "$MAINTENANCE_PLIST" "$LAUNCH_DIR/$MAINTENANCE_LABEL.plist" 644
    /usr/sbin/chown root:wheel "$LAUNCH_DIR/$LABEL.plist" "$LAUNCH_DIR/$NGINX_LABEL.plist" "$LAUNCH_DIR/$MAINTENANCE_LABEL.plist" 2>/dev/null || true
}

remove_autostart_plists() {
    /bin/rm -f "$LAUNCH_DIR/$LABEL.plist" "$LAUNCH_DIR/$NGINX_LABEL.plist" "$LAUNCH_DIR/$MAINTENANCE_LABEL.plist"
}

prod_autostart_on() {
    [ -f "$LAUNCH_DIR/$LABEL.plist" ] && ! label_disabled system "$LABEL"
}

# 旧版本用 launchctl disable 表示“关闭自启”，这里改成删除启动目录中的配置。
migrate_legacy_disabled() {
    for legacy_label in "$LABEL" "$NGINX_LABEL" "$MAINTENANCE_LABEL"; do
        if label_disabled system "$legacy_label"; then
            "$LAUNCHCTL" enable "system/$legacy_label" >/dev/null 2>&1 || true
            remove_autostart_plists
            : > "$AUTOSTART_OFF_MARK"
        fi
    done
}

plist_for() {
    if [ -f "$LAUNCH_DIR/$1.plist" ]; then
        printf '%s/%s.plist' "$LAUNCH_DIR" "$1"
    else
        printf '%s/%s.plist' "$CONFIG_DIR" "$1"
    fi
}

bootout_label() {
    label=$1
    "$LAUNCHCTL" bootout "system/$label" >/dev/null 2>&1 || true
}

bootstrap_label() {
    label=$1
    bootout_label "$label"
    "$LAUNCHCTL" bootstrap system "$(plist_for "$label")"
}

validate_certificate() {
    domain=$1
    certificate=$2
    private_key=$3
    [ -f "$certificate" ] || fail "找不到证书文件：$certificate"
    [ -f "$private_key" ] || fail "找不到私钥文件：$private_key"
    brew_path=$(find_brew) || fail "未找到Homebrew。"
    openssl_bin="$(brew_value "$brew_path" --prefix openssl@3)/bin/openssl"
    [ -x "$openssl_bin" ] || fail "未找到OpenSSL 3。"
    "$openssl_bin" x509 -in "$certificate" -noout -checkend 604800 >/dev/null || fail "源站证书即将过期或已经失效。"
    "$openssl_bin" x509 -in "$certificate" -noout -checkhost "$domain" >/dev/null || fail "源站证书没有覆盖设置的域名。"
    identity=$("$openssl_bin" x509 -in "$certificate" -noout -issuer -subject)
    printf '%s' "$identity" | /usr/bin/grep -Eiq 'CloudFlare Origin|Cloudflare Origin' || fail "只接受Cloudflare Origin CA源站证书。"
    "$openssl_bin" pkey -in "$private_key" -passin pass: -noout -check >/dev/null || fail "源站私钥无效，或私钥带有密码。"
    cert_hash=$("$openssl_bin" x509 -in "$certificate" -pubkey -noout | "$openssl_bin" sha256)
    key_hash=$("$openssl_bin" pkey -in "$private_key" -passin pass: -pubout | "$openssl_bin" sha256)
    [ "$cert_hash" = "$key_hash" ] || fail "源站证书与私钥不匹配。"
}

# 部署或更新结束后：首次部署默认开启开机自启，之后尊重用户在面板里的选择。
finish_deploy() {
    if [ -f "$AUTOSTART_OFF_MARK" ]; then
        if [ -f "$LAUNCH_DIR/$LABEL.plist" ]; then copy_plists; fi
    else
        copy_plists
    fi
    start_services
}

configure_tls() {
    [ "$#" -ge 3 ] || fail "用法：sudo bakaimg configure 域名 源站证书PEM 私钥PEM"
    domain=$(normalize_domain "$1")
    certificate=$2
    private_key=$3
    validate_certificate "$domain" "$certificate" "$private_key"
    /bin/mkdir -p "$TLS_DIR"
    atomic_install "$certificate" "$CERT_FILE" 644
    atomic_install "$private_key" "$KEY_FILE" 600
    project_root=$(config_get PROJECT_ROOT)
    run_user=$(config_get RUN_USER)
    port=$(config_get LOCAL_PORT)
    days=$(config_get RETENTION_DAYS)
    size=$(config_get MAX_SIZE_MIB)
    brew_path=$(config_get BREW)
    write_config "$project_root" "$run_user" "$domain" "$port" "$days" "$size" "$brew_path"
    write_runtime_files
    "$(brew_value "$brew_path" --prefix nginx)/bin/nginx" -t -c "$NGINX_FILE"
    finish_deploy
    say "已设置唯一访问域名：https://$domain"
}

install_runtime() {
    require_root install
    require_macos
    project_root=${BAKAIMG_PROJECT_ROOT:-$INSTALL_DIR_DEFAULT}
    [ -f "$project_root/serve.py" ] || fail "安装目录中缺少serve.py：$project_root"
    run_user=$(detect_run_user)
    /usr/bin/id "$run_user" >/dev/null 2>&1 || fail "运行用户不存在：$run_user"
    brew_path=$(find_brew) || fail "请先安装Homebrew，再重新运行部署脚本。"
    run_as_user "$run_user" "$brew_path" install python@3.14 nginx openssl@3 git
    python_bin="$(run_as_user "$run_user" "$brew_path" --prefix python@3.14)/bin/python3.14"
    [ -x "$python_bin" ] || fail "未找到Homebrew Python 3.14。"
    /bin/mkdir -p "$project_root/instance" "$LOG_DIR" "$TLS_DIR"
    /usr/sbin/chown -R "$run_user":staff "$project_root" "$LOG_DIR"
    if [ ! -x "$project_root/.venv/bin/python" ]; then
        run_as_user "$run_user" "$python_bin" -m venv "$project_root/.venv"
    fi
    case "$(uname -m)" in
        arm64) wheelhouse="$project_root/wheelhouse-macos-arm64" ;;
        x86_64) wheelhouse="$project_root/wheelhouse-macos-x64" ;;
    esac
    [ -d "$wheelhouse" ] || fail "缺少当前Mac对应的离线依赖目录：$wheelhouse"
    run_as_user "$run_user" "$project_root/.venv/bin/python" -m pip install \
        --disable-pip-version-check --no-index --find-links "$wheelhouse" \
        -r "$project_root/requirements-macos.txt"
    current_domain=$(config_get DOMAIN || true)
    current_port=$(config_get LOCAL_PORT || true)
    current_days=$(config_get RETENTION_DAYS || true)
    current_size=$(config_get MAX_SIZE_MIB || true)
    [ -n "$current_port" ] || current_port=$PORT_DEFAULT
    [ -n "$current_days" ] || current_days=$LOG_RETENTION_DEFAULT
    [ -n "$current_size" ] || current_size=$LOG_MAX_MIB_DEFAULT
    write_config "$project_root" "$run_user" "$current_domain" "$current_port" "$current_days" "$current_size" "$brew_path"
    /bin/mkdir -p /usr/local/bin
    atomic_install "$project_root/bakaimg-macos" /usr/local/bin/bakaimg 755
    atomic_install "$project_root/bakaimg-macos" /usr/local/bin/bakaimg-macos 755
    if [ "$#" -ge 3 ]; then
        configure_tls "$1" "$2" "$3"
    elif [ -n "$current_domain" ] && [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ]; then
        write_runtime_files
        finish_deploy
    else
        say "macOS运行环境已安装。请运行 sudo bakaimg configure 域名 源站证书 私钥。"
    fi
}

load_env_value() {
    key=$1
    /usr/bin/awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE"
}

# 以运行用户身份执行项目的 flask 命令（需要项目目录作为当前目录）。
prod_flask() {
    project_root=$(config_get PROJECT_ROOT)
    run_user=$(config_get RUN_USER)
    python_bin="$project_root/.venv/bin/python"
    [ -x "$python_bin" ] || fail "Python运行环境不存在。"
    (
        cd "$project_root"
        run_as_user "$run_user" /usr/bin/env \
            CLOUDNEST_ENV="$(load_env_value CLOUDNEST_ENV)" \
            CLOUDNEST_SITE_URL="$(load_env_value CLOUDNEST_SITE_URL)" \
            CLOUDNEST_ALLOWED_HOST="$(load_env_value CLOUDNEST_ALLOWED_HOST)" \
            CLOUDNEST_HOST=127.0.0.1 \
            CLOUDNEST_PORT="$(load_env_value CLOUDNEST_PORT)" \
            CLOUDNEST_TRUST_PROXY_HOPS=1 \
            CLOUDNEST_SECRET_KEY="$(load_env_value CLOUDNEST_SECRET_KEY)" \
            PYTHONUNBUFFERED=1 \
            "$python_bin" -m flask --app wsgi:app "$@"
    )
}

run_flask_checks() {
    prod_flask db upgrade
    prod_flask init-site
    prod_flask system-check
    prod_flask media-check
}

prepare_port() {
    require_root prepare-port
    project_root=$(config_get PROJECT_ROOT)
    run_user=$(config_get RUN_USER)
    domain=$(config_get DOMAIN)
    preferred=$(config_get LOCAL_PORT)
    days=$(config_get RETENTION_DAYS)
    size=$(config_get MAX_SIZE_MIB)
    brew_path=$(config_get BREW)
    selected=$(find_available_port "$preferred")
    write_config "$project_root" "$run_user" "$domain" "$selected" "$days" "$size" "$brew_path"
    write_runtime_files
    if [ "$selected" != "$preferred" ]; then say "端口${preferred}已占用，已切换到127.0.0.1:${selected}。"; fi
    printf '%s\n' "$selected" > "$CONFIG_DIR/active-port"
}

run_service() {
    require_root run-service
    prepare_port
    run_flask_checks
    project_root=$(config_get PROJECT_ROOT)
    run_user=$(config_get RUN_USER)
    python_bin="$project_root/.venv/bin/python"
    port=$(load_env_value CLOUDNEST_PORT)
    nginx_bin="$(config_get BREW)"
    nginx_bin="$(brew_value "$nginx_bin" --prefix nginx)/bin/nginx"
    "$nginx_bin" -t -c "$NGINX_FILE" >/dev/null
    "$nginx_bin" -s reload -c "$NGINX_FILE" >/dev/null 2>&1 || true
    exec /usr/bin/sudo -H -u "$run_user" /usr/bin/env \
        CLOUDNEST_ENV=production \
        CLOUDNEST_SITE_URL="$(load_env_value CLOUDNEST_SITE_URL)" \
        CLOUDNEST_ALLOWED_HOST="$(load_env_value CLOUDNEST_ALLOWED_HOST)" \
        CLOUDNEST_HOST=127.0.0.1 \
        CLOUDNEST_PORT="$port" \
        CLOUDNEST_TRUST_PROXY_HOPS=1 \
        CLOUDNEST_THREADS=8 \
        CLOUDNEST_SECRET_KEY="$(load_env_value CLOUDNEST_SECRET_KEY)" \
        PYTHONUNBUFFERED=1 \
        "$python_bin" "$project_root/serve.py"
}

prod_active_port() {
    value=""
    [ ! -f "$CONFIG_DIR/active-port" ] || value=$(/usr/bin/head -n 1 "$CONFIG_DIR/active-port" 2>/dev/null || true)
    valid_port "${value:-}" || value=$(config_get LOCAL_PORT || true)
    valid_port "${value:-}" || value=$PORT_DEFAULT
    printf '%s' "$value"
}

prod_start() {
    require_root start
    [ -f "$NGINX_FILE" ] && [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] || fail "请先设置域名和源站证书。"
    brew_path=$(config_get BREW)
    [ -n "$brew_path" ] || fail "部署配置不完整。"
    nginx_bin="$(brew_value "$brew_path" --prefix nginx)/bin/nginx"
    [ -x "$nginx_bin" ] || nginx_bin="$(brew_value "$brew_path" --prefix)/bin/nginx"
    "$nginx_bin" -t -c "$NGINX_FILE" >/dev/null || fail "Nginx配置检查未通过。"
    migrate_legacy_disabled
    if [ -f "$LAUNCH_DIR/$LABEL.plist" ]; then copy_plists; fi
    bootstrap_label "$NGINX_LABEL"
    bootstrap_label "$MAINTENANCE_LABEL"
    bootstrap_label "$LABEL"
    say "服务已启动。"
}

prod_stop() {
    require_root stop
    bootout_label "$LABEL"
    bootout_label "$NGINX_LABEL"
    say "服务已停止。"
    if prod_autostart_on; then say "提示：开机自启仍处于开启状态，下次开机会自动运行。"; fi
}

prod_enable() {
    require_root enable
    [ -f "$APP_PLIST" ] && [ -f "$NGINX_PLIST" ] && [ -f "$MAINTENANCE_PLIST" ] || fail "请先设置域名和源站证书。"
    copy_plists
    for item in "$LABEL" "$NGINX_LABEL" "$MAINTENANCE_LABEL"; do
        "$LAUNCHCTL" enable "system/$item" >/dev/null 2>&1 || true
    done
    /bin/rm -f "$AUTOSTART_OFF_MARK"
    say "开机自启已开启（当前运行状态不变）。"
}

prod_disable() {
    require_root disable
    remove_autostart_plists
    : > "$AUTOSTART_OFF_MARK"
    say "开机自启已关闭（当前运行状态不变，下次开机不会自动运行）。"
}

# ================================================================ 本机运行（无需sudo）

local_require_project() {
    [ -f "$LOCAL_ROOT/serve.py" ] && [ -f "$LOCAL_ROOT/wsgi.py" ] && [ -d "$LOCAL_ROOT/app" ] ||
        fail "找不到项目文件。请在项目目录中运行本脚本；正式部署请先执行 sudo sh deploy-macos.sh。"
}

local_prepare_dirs() {
    /bin/mkdir -p "$LOCAL_RUNTIME_DIR" "$LOCAL_LOG_DIR"
}

local_conf_get() {
    [ -f "$LOCAL_CONF" ] || return 0
    /usr/bin/awk -F= -v key="$1" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$LOCAL_CONF"
}

local_pref_port() {
    value=$(local_conf_get PORT || true)
    if valid_port "${value:-}"; then printf '%s' "$value"; else printf '%s' "$PORT_DEFAULT"; fi
}

local_set_pref_port() {
    local_prepare_dirs
    printf 'PORT=%s\n' "$1" > "$LOCAL_CONF.tmp.$$"
    /bin/mv -f "$LOCAL_CONF.tmp.$$" "$LOCAL_CONF"
}

local_job_target() { printf '%s/%s' "$LOCAL_DOMAIN" "$LOCAL_LABEL"; }

local_direct_pid() {
    [ -f "$LOCAL_PID_FILE" ] || return 0
    recorded=$(/usr/bin/head -n 1 "$LOCAL_PID_FILE" 2>/dev/null || true)
    if pid_alive "$recorded" && pid_is_app "$recorded"; then printf '%s' "$recorded"; fi
}

local_app_pid() {
    found=$(job_pid "$(local_job_target)" || true)
    if [ -z "$found" ]; then found=$(local_direct_pid || true); fi
    printf '%s' "$found"
}

local_run_source() {
    if [ -n "$(job_pid "$(local_job_target)" || true)" ]; then printf '开机自启托管'; else printf '手动启动'; fi
}

local_active_port() {
    value=""
    [ ! -f "$LOCAL_PORT_FILE" ] || value=$(/usr/bin/head -n 1 "$LOCAL_PORT_FILE" 2>/dev/null || true)
    if valid_port "${value:-}"; then printf '%s' "$value"; else local_pref_port; fi
}

local_agent_file() { printf '%s/%s.plist' "$LOCAL_AGENT_DIR" "$LOCAL_LABEL"; }

local_autostart_on() {
    [ -f "$(local_agent_file)" ] && ! label_disabled "$LOCAL_DOMAIN" "$LOCAL_LABEL"
}

local_autostart_path_ok() {
    /usr/bin/grep -qF "<string>$(xml_escape "$SELF")</string>" "$(local_agent_file)" 2>/dev/null
}

protected_location() {
    case $1 in
        "${HOME:-/nonexistent}"/Desktop|"${HOME:-/nonexistent}"/Desktop/*) return 0 ;;
        "${HOME:-/nonexistent}"/Documents|"${HOME:-/nonexistent}"/Documents/*) return 0 ;;
        "${HOME:-/nonexistent}"/Downloads|"${HOME:-/nonexistent}"/Downloads/*) return 0 ;;
    esac
    return 1
}

requirements_hash() {
    /usr/bin/shasum -a 256 "$LOCAL_ROOT/requirements-macos.txt" 2>/dev/null | /usr/bin/awk '{print $1}'
}

local_env_state() {
    if [ ! -x "$LOCAL_VENV/bin/python" ] || [ ! -f "$LOCAL_DEPS_MARK" ]; then printf missing; return; fi
    have=$(/usr/bin/awk -F= '$1 == "requirements" {print $2; exit}' "$LOCAL_DEPS_MARK")
    if [ "$have" = "$(requirements_hash)" ]; then printf ready; else printf outdated; fi
}

local_env_python_version() {
    /usr/bin/awk -F= '$1 == "python" {print $2; exit}' "$LOCAL_DEPS_MARK" 2>/dev/null
}

python_ok() {
    [ -n "${1:-}" ] && [ -x "$1" ] || return 1
    "$1" -c 'import sys; raise SystemExit(0 if (3, 12) <= sys.version_info[:2] <= (3, 14) else 1)' 2>/dev/null
}

# 优先Python 3.14（与随项目提供的离线依赖一致），其次3.13、3.12。
find_python() {
    if [ -n "${BAKAIMG_PYTHON:-}" ]; then
        python_ok "$BAKAIMG_PYTHON" || return 1
        printf '%s' "$BAKAIMG_PYTHON"
        return 0
    fi
    brew_path=$(find_brew 2>/dev/null || true)
    for minor in 14 13 12; do
        if [ -n "$brew_path" ]; then
            prefix=$("$brew_path" --prefix "python@3.$minor" 2>/dev/null || true)
            if [ -n "$prefix" ] && python_ok "$prefix/bin/python3.$minor"; then
                printf '%s' "$prefix/bin/python3.$minor"
                return 0
            fi
        fi
        for directory in /opt/homebrew/bin /usr/local/bin "${HOME:-/nonexistent}/.local/bin" "${HOME:-/nonexistent}/.homebrew/Homebrew/bin"; do
            if python_ok "$directory/python3.$minor"; then
                printf '%s' "$directory/python3.$minor"
                return 0
            fi
        done
        found=$(command -v "python3.$minor" 2>/dev/null || true)
        if python_ok "$found"; then printf '%s' "$found"; return 0; fi
    done
    return 1
}

local_wheelhouse() {
    case "$(uname -m)" in
        arm64) printf '%s' "$LOCAL_ROOT/wheelhouse-macos-arm64" ;;
        *) printf '%s' "$LOCAL_ROOT/wheelhouse-macos-x64" ;;
    esac
}

local_setup() {
    local_require_project
    require_macos
    source_python=$(find_python || true)
    if [ -z "$source_python" ]; then
        say "没有找到可用的 Python 3.12 至 3.14。"
        brew_path=$(find_brew 2>/dev/null || true)
        if [ -n "$brew_path" ] && confirm "是否用 Homebrew 安装 Python 3.14？" n; then
            "$brew_path" install python@3.14 || fail "Homebrew 安装 Python 3.14 失败。"
            source_python=$(find_python || true)
        fi
        [ -n "$source_python" ] || fail "请先安装 Python 3.14（brew install python@3.14）后重新运行。"
    fi
    say "使用 Python：$source_python"
    if [ ! -x "$LOCAL_VENV/bin/python" ]; then
        quiet_run "创建独立运行环境" "$source_python" -m venv "$LOCAL_VENV" || fail "无法创建运行环境：$(short_path "$LOCAL_VENV")"
    fi
    venv_python="$LOCAL_VENV/bin/python"
    "$venv_python" -c 'pass' 2>/dev/null || fail "运行环境已损坏，请删除 $(short_path "$LOCAL_VENV") 后重新安装。"
    wheelhouse=$(local_wheelhouse)
    installed=0
    if [ -d "$wheelhouse" ] && quiet_run "从本地离线包安装依赖" "$venv_python" -m pip install --disable-pip-version-check --no-index --find-links "$wheelhouse" -r "$LOCAL_ROOT/requirements-macos.txt"; then
        installed=1
    elif confirm "离线安装没有成功，是否联网安装同版本依赖？" n; then
        quiet_run "联网安装依赖" "$venv_python" -m pip install --disable-pip-version-check -r "$LOCAL_ROOT/requirements-macos.txt" && installed=1
    fi
    [ "$installed" -eq 1 ] || fail "依赖安装未完成。"
    python_version=$("$venv_python" -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')
    printf 'python=%s\nrequirements=%s\n' "$python_version" "$(requirements_hash)" > "$LOCAL_DEPS_MARK"
    say "运行环境已就绪（Python ${python_version}）。"
}

local_ensure_env() {
    state=$(local_env_state)
    [ "$state" != ready ] || return 0
    case $state in
        missing) say "运行环境尚未安装。" ;;
        *) say "依赖清单已变化，运行环境需要更新。" ;;
    esac
    confirm "现在安装/更新运行环境？" y || return 1
    local_setup
}

local_flask() {
    (
        cd "$LOCAL_ROOT"
        /usr/bin/env \
            CLOUDNEST_ENV=development \
            CLOUDNEST_HOST=127.0.0.1 \
            CLOUDNEST_PORT="$FLASK_PORT" \
            CLOUDNEST_SITE_URL="http://127.0.0.1:$FLASK_PORT" \
            PYTHONUNBUFFERED=1 \
            PYTHONDONTWRITEBYTECODE=1 \
            "$LOCAL_VENV/bin/python" -m flask --app wsgi:app "$@"
    )
}

# 由后台进程或launchd调用：选端口、迁移与检查、再启动服务。
run_local() {
    local_require_project
    [ "$(local_env_state)" = ready ] || fail "运行环境未就绪，请在管理面板选择“安装/修复运行环境”。"
    local_prepare_dirs
    FLASK_PORT=$(find_available_port "$(local_pref_port)")
    printf '%s\n' "$FLASK_PORT" > "$LOCAL_PORT_FILE"
    say "[bakaimg] $(/bin/date '+%Y-%m-%d %H:%M:%S') 准备启动，端口 $FLASK_PORT"
    local_flask db upgrade
    local_flask init-site
    local_flask system-check
    local_flask media-check
    say "[bakaimg] 本地测试地址：http://127.0.0.1:$FLASK_PORT"
    cd "$LOCAL_ROOT"
    exec /usr/bin/env \
        CLOUDNEST_ENV=development \
        CLOUDNEST_HOST=127.0.0.1 \
        CLOUDNEST_PORT="$FLASK_PORT" \
        CLOUDNEST_SITE_URL="http://127.0.0.1:$FLASK_PORT" \
        PYTHONUNBUFFERED=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        "$LOCAL_VENV/bin/python" -m flask --app wsgi:app run --host 127.0.0.1 --port "$FLASK_PORT" --no-debugger --no-reload
}

# 开机自启检查：模拟launchd的方式读取项目目录。
probe_access() {
    cd "$LOCAL_ROOT"
    [ -r serve.py ] && [ -d instance ] || exit 1
    if [ -x "$LOCAL_VENV/bin/python" ]; then
        "$LOCAL_VENV/bin/python" -c "import os; open('serve.py').close(); os.listdir('instance')" || exit 1
    fi
}

local_probe_access() {
    probe_label="$LOCAL_LABEL.probe"
    probe_plist="$LOCAL_RUNTIME_DIR/$probe_label.plist"
    local_prepare_dirs
    render_local_plist "$probe_plist" "$probe_label" probe-access 0
    "$LAUNCHCTL" bootout "$LOCAL_DOMAIN/$probe_label" >/dev/null 2>&1 || true
    if ! "$LAUNCHCTL" bootstrap "$LOCAL_DOMAIN" "$probe_plist" >/dev/null 2>&1; then
        /bin/rm -f "$probe_plist"
        return 1
    fi
    code=""
    waited=0
    while [ "$waited" -lt 10 ]; do
        code=$("$LAUNCHCTL" print "$LOCAL_DOMAIN/$probe_label" 2>/dev/null | /usr/bin/awk -F' = ' '/last exit code/ {print $2; exit}')
        case $code in ''|*never*) /bin/sleep 1; waited=$((waited + 1)) ;; *) break ;; esac
    done
    "$LAUNCHCTL" bootout "$LOCAL_DOMAIN/$probe_label" >/dev/null 2>&1 || true
    /bin/rm -f "$probe_plist"
    [ "$code" = 0 ]
}

spawn_detached() {
    if [ -x /usr/bin/perl ]; then
        /usr/bin/nohup /usr/bin/perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- "$@" </dev/null >>"$LOCAL_APP_LOG" 2>&1 &
    else
        /usr/bin/nohup "$@" </dev/null >>"$LOCAL_APP_LOG" 2>&1 &
    fi
    SPAWNED_PID=$!
}

wait_until_ready() {
    limit=$1
    waited=0
    printf '正在启动'
    while [ "$waited" -lt "$limit" ]; do
        current=$(app_pid || true)
        if [ -n "$current" ]; then
            if { [ "$MODE" != local ] || [ -f "$LOCAL_PORT_FILE" ]; } && [ -n "$(health_body "$(active_port)")" ]; then printf '\n'; return 0; fi
        elif [ "$waited" -ge 2 ]; then
            printf '\n'
            return 1
        fi
        printf '.'
        /bin/sleep 1
        waited=$((waited + 1))
    done
    printf '\n'
    return 1
}

local_start() {
    local_require_project
    require_macos
    current=$(local_app_pid || true)
    if [ -n "$current" ]; then
        say "服务已在运行（PID ${current}）：http://127.0.0.1:$(local_active_port)"
        return 0
    fi
    if job_loaded "$(local_job_target)"; then
        "$LAUNCHCTL" bootout "$(local_job_target)" >/dev/null 2>&1 || true
    fi
    local_ensure_env || fail "运行环境未就绪，已取消启动。"
    local_prepare_dirs
    /bin/rm -f "$LOCAL_PORT_FILE"
    spawn_detached /bin/sh "$SELF" run-local
    printf '%s\n' "$SPAWNED_PID" > "$LOCAL_PID_FILE"
    if wait_until_ready 45; then
        say "服务已启动：http://127.0.0.1:$(local_active_port)（PID $(local_app_pid)）"
        return 0
    fi
    say "启动没有成功，最近的日志："
    /usr/bin/tail -n 15 "$LOCAL_APP_LOG" 2>/dev/null || true
    /bin/rm -f "$LOCAL_PID_FILE"
    return 1
}

local_stop() {
    stopped=0
    if job_loaded "$(local_job_target)"; then
        "$LAUNCHCTL" bootout "$(local_job_target)" >/dev/null 2>&1 || true
        stopped=1
    fi
    direct=$(local_direct_pid || true)
    if [ -n "$direct" ]; then
        /bin/kill -TERM "$direct" 2>/dev/null || true
        waited=0
        while pid_alive "$direct" && [ "$waited" -lt 20 ]; do
            /bin/sleep 0.5
            waited=$((waited + 1))
        done
        if pid_alive "$direct"; then /bin/kill -KILL "$direct" 2>/dev/null || true; fi
        stopped=1
    fi
    /bin/rm -f "$LOCAL_PID_FILE"
    if [ "$stopped" -eq 1 ]; then say "服务已停止。"; else say "服务本来就没有运行。"; fi
    if local_autostart_on; then say "提示：开机自启仍处于开启状态，下次登录会自动运行。"; fi
}

local_enable() {
    local_require_project
    require_macos
    local_ensure_env || fail "需要先安装运行环境。"
    local_prepare_dirs
    say "正在检查开机自启能否读取项目目录…"
    if ! local_probe_access; then
        printf '%s\n' \
            "无法开启开机自启：macOS 的隐私保护会阻止后台任务读取这个目录。" \
            "当前位置：$(short_path "$LOCAL_ROOT")" \
            "" \
            "任选一种办法后再试一次：" \
            "  1) 把整个项目文件夹移到不受保护的位置，例如 ~/bakaimg（推荐）；" \
            "  2) 在“系统设置 → 隐私与安全性 → 完全磁盘访问权限”中添加 /bin/sh 和运行环境里的 python。" \
            "手动启动、停止不受影响，仍可正常使用。"
        return 1
    fi
    /bin/mkdir -p "$LOCAL_AGENT_DIR"
    render_local_plist "$(local_agent_file).tmp.$$"
    /bin/chmod 644 "$(local_agent_file).tmp.$$"
    /bin/mv -f "$(local_agent_file).tmp.$$" "$(local_agent_file)"
    "$LAUNCHCTL" enable "$(local_job_target)" >/dev/null 2>&1 || true
    say "开机自启已开启：下次登录起自动运行（当前运行状态不变）。"
}

local_disable() {
    /bin/rm -f "$(local_agent_file)"
    say "开机自启已关闭（当前运行状态不变，下次登录不会自动运行）。"
}

