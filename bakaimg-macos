doctor_production() {
    require_macos
    failed=0
    for item in "$CONFIG_FILE" "$ENV_FILE" "$NGINX_FILE" "$CERT_FILE" "$KEY_FILE"; do
        if [ -f "$item" ]; then say "正常：$item"; else say "缺少：$item"; failed=1; fi
