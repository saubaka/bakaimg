maintenance() {
    if [ "$MODE" = local ]; then
        rotate_dir=$LOCAL_LOG_DIR
        days=$LOG_RETENTION_DEFAULT
        size_mib=$LOG_MAX_MIB_DEFAULT
        rotate_files="bakaimg-macos.log"
    else
        require_root maintenance
        rotate_dir=$LOG_DIR
        days=$(config_get RETENTION_DAYS || printf %s "$LOG_RETENTION_DEFAULT")
        size_mib=$(config_get MAX_SIZE_MIB || printf %s "$LOG_MAX_MIB_DEFAULT")
        rotate_files="app.log error.log access.log nginx-error.log nginx-launch.log maintenance.log maintenance-error.log"
    fi
    max_bytes=$((size_mib * 1024 * 1024))
    timestamp=$(/bin/date '+%Y%m%d-%H%M%S')
    rotated=0
    for log_file in $rotate_files; do
        source_path="$rotate_dir/$log_file"
        [ -f "$source_path" ] || continue
        bytes=$(/usr/bin/stat -f '%z' "$source_path" 2>/dev/null || printf 0)
        [ "$bytes" -ge "$max_bytes" ] || continue
        archive_path="$source_path.$timestamp"
        /bin/cp -p "$source_path" "$archive_path"
        : > "$source_path"
        /usr/bin/gzip -f "$archive_path"
        rotated=$((rotated + 1))
    done
    /usr/bin/find "$rotate_dir" -type f -name '*.log.*.gz' -mtime "+$days" -delete 2>/dev/null || true
    say "日志整理完成（保留${days}天，单文件超过${size_mib}MiB时压缩归档，本次归档${rotated}个）。"
}

