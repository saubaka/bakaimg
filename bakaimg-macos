    show_status
    printf '  %s\n' "$(dim "── 运行 ──────────────────────────────")"
    printf '   1  启动服务\n   2  停止服务\n   3  重新启动\n'
    printf '  %s\n' "$(dim "── 开机自启 ──────────────────────────")"
    printf '   4  开启开机自启\n   5  关闭开机自启\n'
    printf '  %s\n' "$(dim "── 常用工具 ──────────────────────────")"
    printf '   6  修改端口\n   7  在浏览器中打开\n   8  查看日志（最近120行）\n   9  实时日志（Ctrl+C 返回）\n'
    printf '  10  创建数据备份\n  11  整理日志\n  12  运行检查\n'
    if [ "$MODE" = local ]; then
        printf '  %s\n' "$(dim "── 本机环境 ──────────────────────────")"
        printf '  13  安装/修复运行环境\n  14  生成本机管理员恢复链接\n'
    else
        printf '  %s\n' "$(dim "── 正式部署 ──────────────────────────")"
        printf '  13  更新域名与证书\n  14  修改日志规则\n'
    fi
    printf '   0  退出        %s\n\n' "$(dim "直接回车 = 刷新状态")"
}

menu_action() {
    # 单个操作失败不应该让面板退出；关闭外层 -e，让子进程内部的 -e 仍然生效。
    set +e
    ( set -e; "$@" )
    action_status=$?
    set -e
    if [ "$action_status" -ne 0 ]; then printf '%s操作没有完成。%s\n' "$C_YELLOW" "$C_RESET"; fi
    return 0
}

menu() {
    MENU_ACTIVE=1
    trap 'printf "\n"; exit 0' INT
    while :; do
        menu_banner
        printf '请选择：'
        IFS= read -r choice || { printf '\n'; exit 0; }
        printf '\n'
        case "$choice" in
            '') continue ;;
            1) menu_action do_start ;;
            2) menu_action do_stop ;;
            3) menu_action do_restart ;;
            4) menu_action do_enable ;;
            5) menu_action do_disable ;;
            6)
                printf '首选端口（1024-65535，当前 %s，直接回车取消）：' "$(active_port)"
                IFS= read -r value || value=""
                if [ -n "$value" ]; then menu_action set_port "$value"; else say "已取消。"; fi
                ;;
            7) menu_action open_site ;;
            8) menu_action show_logs 120 ;;
            9) follow_logs ;;
            10) menu_action backup_now ;;
            11) menu_action maintenance ;;
            12) menu_action doctor ;;
            13)
                if [ "$MODE" = local ]; then
                    menu_action local_setup
                else
                    printf '唯一访问域名：'; IFS= read -r d || d=""
                    printf '源站证书PEM路径：'; IFS= read -r c || c=""
                    printf '源站私钥PEM路径：'; IFS= read -r k || k=""
                    menu_action configure_tls "$d" "$c" "$k"
                fi
                ;;
            14)
                if [ "$MODE" = local ]; then
                    menu_action recovery_link
                else
                    printf '保留天数：'; IFS= read -r d || d=""
                    printf '单文件最大MiB：'; IFS= read -r s || s=""
                    menu_action configure_retention "$d" "$s"
                fi
                ;;
            0|q|Q) exit 0 ;;
            *) say "请输入列表中的编号。" ;;
        esac
        pause_panel
    done
}

usage() {
    cat <<EOF
bakaimg macOS 管理面板 $VERSION

用法：bakaimg-macos [命令]        （不带命令时打开数字管理面板）
  menu                   打开数字管理面板
  status | --status-json 查看运行状态、端口与开机自启
  start | stop | restart 启动、停止、重新启动服务
  enable | disable       开启、关闭开机自启（不影响当前运行）
  port 端口              修改首选端口
  open                   在浏览器中打开网站
  logs [行数] | follow   查看日志 / 实时跟踪日志
  backup                 创建并校验数据备份
  maintenance            立即整理日志
  doctor                 运行检查

本机运行（在项目目录中，无需sudo）：
  setup                  安装/修复运行环境
  recovery               生成本机管理员恢复链接
  可用 BAKAIMG_PYTHON 指定 Python，BAKAIMG_VENV_DIR 指定运行环境目录。

正式部署（sudo bakaimg ...）：
  install [域名 证书 私钥]  安装或更新
  configure 域名 证书 私钥 设置唯一域名与源站证书
  retention 天数 MiB        修改日志保留规则
EOF
}

elevate() {
    # BAKAIMG_NO_ELEVATE 仅供自动化测试读取状态；所有写操作仍会各自检查管理员权限。
    [ -z "${BAKAIMG_NO_ELEVATE:-}" ] || return 0
    if [ "$MODE" = production ] && [ "$(id -u)" -ne 0 ]; then
        say "正式部署的管理需要管理员权限，请输入本机密码。"
        exec /usr/bin/sudo -H /bin/sh "$SELF" "$command" "$@"
    fi
}

require_mode() {
    wanted=$1
    shift
    [ "$MODE" = "$wanted" ] && return 0
    if [ "$wanted" = production ]; then
        fail "“$*”只在正式部署方式下可用（需要先运行 sudo sh deploy-macos.sh）。"
    fi
    fail "“$*”只在本机运行方式下可用。"
}

# ---------------------------------------------------------------- 入口

SELF=$(resolve_self "$0")
SELF_DIR=$(/usr/bin/dirname "$SELF")
LOCAL_ROOT=$SELF_DIR

case ${BAKAIMG_MODE:-} in
    local|production) MODE=$BAKAIMG_MODE ;;
    *) if [ -f "$CONFIG_FILE" ]; then MODE=production; else MODE=local; fi ;;
esac

LOCAL_LABEL="${BAKAIMG_LOCAL_LABEL:-com.saubaka.bakaimg.local}"
LOCAL_AGENT_DIR="${BAKAIMG_LOCAL_LAUNCH_DIR:-${HOME:-/var/root}/Library/LaunchAgents}"
LOCAL_RUNTIME_DIR="$LOCAL_ROOT/instance/runtime"
LOCAL_LOG_DIR="$LOCAL_ROOT/instance/logs"
LOCAL_CONF="$LOCAL_RUNTIME_DIR/macos-local.conf"
LOCAL_PORT_FILE="$LOCAL_RUNTIME_DIR/macos-local.port"
LOCAL_PID_FILE="$LOCAL_RUNTIME_DIR/macos-local.pid"
LOCAL_APP_LOG="$LOCAL_LOG_DIR/bakaimg-macos.log"
LOCAL_VENV="${BAKAIMG_VENV_DIR:-$LOCAL_ROOT/.venv-macos}"
LOCAL_DEPS_MARK="$LOCAL_VENV/.bakaimg-deps"
LOCAL_DOMAIN="gui/$(/usr/bin/id -u)"
FLASK_PORT=$PORT_DEFAULT
MENU_ACTIVE=0

setup_colors

command=${1:-menu}
[ "$#" -eq 0 ] || shift
case "$command" in
    menu|status|--status-json|start|stop|restart|enable|disable|port|open|logs|follow|backup|maintenance|doctor|retention|configure)
        elevate "$@" ;;
esac

case "$command" in
    menu) menu ;;
    install) require_mode production install; install_runtime "$@" ;;
    configure) require_mode production configure; require_root configure; configure_tls "$@" ;;
    status) show_status ;;
    --status-json) status_json ;;
    start) do_start ;;
    stop) do_stop ;;
    restart) do_restart ;;
    enable) do_enable ;;
    disable) do_disable ;;
    port) set_port "$@" ;;
    open) open_site ;;
    logs) show_logs "$@" ;;
    follow) follow_logs ;;
    backup) backup_now ;;
    retention) require_mode production retention; configure_retention "$@" ;;
    maintenance) maintenance ;;
    doctor) doctor ;;
    setup) require_mode local setup; local_setup ;;
    recovery) require_mode local recovery; recovery_link ;;
    run-local) require_mode local run-local; run_local ;;
    probe-access) require_mode local probe-access; probe_access ;;
    prepare-port) require_mode production prepare-port; prepare_port ;;
    run-service) require_mode production run-service; run_service ;;
    render-test) render_test "$@" ;;
    port-test) port_test "$@" ;;
    --version|-V) say "$VERSION" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
